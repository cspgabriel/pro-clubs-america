{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pro-clubs-america-notifier",
  "account_id": "8c4f3b0ccc2ee9001b6dd8322b8b6ca9",
  "main": "index.mjs",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // 12:10 UTC = manha no Brasil: melhor janela de abertura para este publico.
  "triggers": { "crons": ["10 12 * * *"] },
  "vars": { "PCA_SITE_URL": "https://proclubsamerica.com" },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
