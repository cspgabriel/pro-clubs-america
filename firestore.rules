rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isClubLeader(clubId) { return signedIn() && user().clubId == clubId && (user().role == 'owner' || user().role == 'captain'); }
    function matchData(matchId) { return get(/databases/$(database)/documents/friendlies/$(matchId)).data; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.elo == resource.data.elo
        && request.resource.data.reliability == resource.data.reliability
        && (
          request.resource.data.role == resource.data.role
          || (request.resource.data.role == 'owner'
            && existsAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubKey))
            && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubKey)).data.ownerUid == uid)
        );
      allow delete: if false;
    }

    match /clubs/{clubKey} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending_review';
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.elo == resource.data.elo
        && request.resource.data.reliability == resource.data.reliability
        && request.resource.data.plan == resource.data.plan;
      allow delete: if false;
    }

    match /friendlies/{matchId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && isClubLeader(request.resource.data.hostClubId)
        && request.resource.data.status == 'searching';
      allow update: if signedIn() && (
        (resource.data.status == 'searching' && request.resource.data.status == 'scheduled'
          && isClubLeader(request.resource.data.opponentClubId)
          && request.resource.data.opponentClubId != resource.data.hostClubId
          && (resource.data.mode == 'open' || resource.data.invitedClubId == request.resource.data.opponentClubId))
        || (resource.data.status == 'scheduled' && request.resource.data.status == 'waiting_ea'
          && (isClubLeader(resource.data.hostClubId) || isClubLeader(resource.data.opponentClubId)))
      );
      allow delete: if signedIn() && resource.data.creatorUid == request.auth.uid && resource.data.status == 'searching';

      match /messages/{messageId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
          && (user().clubId == matchData(matchId).hostClubId || user().clubId == matchData(matchId).opponentClubId);
        allow update, delete: if false;
      }
    }

    match /marketPosts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.plan == resource.data.plan;
    }
  }
}
