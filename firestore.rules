rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function user() { return get(userPath()).data; }
    function clubPath(clubKey) { return /databases/$(database)/documents/clubs/$(clubKey); }
    function isClubLeader(clubId) {
      return signedIn()
        && exists(userPath())
        && user().clubId == clubId
        && user().clubKey is string
        && exists(clubPath(user().clubKey))
        && (
          get(clubPath(user().clubKey)).data.ownerUid == request.auth.uid
          || request.auth.uid in get(clubPath(user().clubKey)).data.captainUids
        );
    }
    function matchData(matchId) { return get(/databases/$(database)/documents/friendlies/$(matchId)).data; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'visitor'
        && request.resource.data.plan == 'free'
        && request.resource.data.elo == 1000
        && request.resource.data.reliability == 100
        && !('clubId' in request.resource.data)
        && !('clubKey' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.elo == resource.data.elo
        && request.resource.data.reliability == resource.data.reliability
        && (
          (request.resource.data.role == resource.data.role
            && request.resource.data.get('clubId', null) == resource.data.get('clubId', null)
            && request.resource.data.get('clubKey', null) == resource.data.get('clubKey', null))
          || (resource.data.role == 'visitor'
            && request.resource.data.role == 'owner'
            && request.resource.data.clubId is string
            && request.resource.data.clubKey is string
            && existsAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubKey))
            && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubKey)).data.ownerUid == uid)
        );
      allow delete: if false;
    }

    match /clubs/{clubKey} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'pending_review';
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.elo == resource.data.elo
        && request.resource.data.reliability == resource.data.reliability
        && request.resource.data.plan == resource.data.plan;
      allow delete: if false;
    }

    match /friendlies/{matchId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && isClubLeader(request.resource.data.hostClubId)
        && request.resource.data.status == 'searching';
      allow update: if signedIn() && (
        (resource.data.status == 'searching' && request.resource.data.status == 'scheduled'
          && isClubLeader(request.resource.data.opponentClubId)
          && request.resource.data.opponentClubId != resource.data.hostClubId
          && (resource.data.mode == 'open' || resource.data.invitedClubId == request.resource.data.opponentClubId))
        || (resource.data.status == 'scheduled' && request.resource.data.status == 'waiting_ea'
          && (isClubLeader(resource.data.hostClubId) || isClubLeader(resource.data.opponentClubId)))
      );
      allow delete: if signedIn() && resource.data.creatorUid == request.auth.uid && resource.data.status == 'searching';

      match /messages/{messageId} {
        allow read: if signedIn() && exists(userPath())
          && (user().clubId == matchData(matchId).hostClubId || user().clubId == matchData(matchId).opponentClubId);
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid
          && (user().clubId == matchData(matchId).hostClubId || user().clubId == matchData(matchId).opponentClubId);
        allow update, delete: if false;
      }
    }

    match /marketPosts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.plan == resource.data.plan;
    }
  }
}
